# Copy this file to .env and fill in your free API keys.
# None of these require payment, KYC, or a crypto wallet with funds.

# https://etherscan.io/apis (free tier, email signup)
ETHERSCAN_API_KEY=

# https://bscscan.com/apis (free tier, email signup)
BSCSCAN_API_KEY=

# https://polygonscan.com/apis (free tier, email signup)
POLYGONSCAN_API_KEY=

# Bitcoin uses Blockstream's public Esplora API - no key required.
BITCOIN_API_BASE_URL=https://blockstream.info/api

# How many hops the tracer follows before giving up
HOP_LIMIT=5

# Local dev defaults (docker-compose overrides these for containers)
DATABASE_URL=postgresql+psycopg2://fraudmap:fraudmap@localhost:5432/fraudmap
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudmap123
REDIS_URL=redis://localhost:6379/0

# Auth - change all of these before deploying anywhere beyond your own
# machine. Two demo accounts are auto-created on first startup.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
DEFAULT_INVESTIGATOR_USERNAME=investigator
DEFAULT_INVESTIGATOR_PASSWORD=changeme123
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme123
